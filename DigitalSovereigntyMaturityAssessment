var PILLAR_COLOR={GOV:"#D11A45",DAT:"#B81F57",TEC:"#A72162",OPE:"#7C2780",SOC:"#652B92",IA:"#512E9E"};
var WEIGHT_PRESETS={
  balanced:{GOV:20,DAT:18,TEC:22,OPE:18,SOC:10,IA:12},
  infra:{GOV:18,DAT:15,TEC:25,OPE:22,SOC:8,IA:12},
  data:{GOV:20,DAT:24,TEC:18,OPE:16,SOC:10,IA:12},
  ai:{GOV:18,DAT:16,TEC:20,OPE:16,SOC:8,IA:22},
  csf:{GOV:24,DAT:14,TEC:30,OPE:16,SOC:6,IA:10}
};
var WEIGHTS_KEY="qsov_weights_v1";
var WEIGHTS=Object.assign({},WEIGHT_PRESETS.balanced);
try{var rawW=localStorage.getItem(WEIGHTS_KEY); if(rawW){var pw=JSON.parse(rawW); if(pw&&typeof pw==="object"){PILLARS.forEach(function(p){if(typeof pw[p.id]==="number")WEIGHTS[p.id]=pw[p.id];});}}}catch(e){}
function saveWeights(){try{localStorage.setItem(WEIGHTS_KEY,JSON.stringify(WEIGHTS));}catch(e){}}
function weightTotal(){var s=0;PILLARS.forEach(function(p){s+=WEIGHTS[p.id]||0;});return s;}
function activePreset(){
  var keys=Object.keys(WEIGHT_PRESETS);
  for(var i=0;i<keys.length;i++){
    var pr=WEIGHT_PRESETS[keys[i]], ok=true;
    for(var j=0;j<PILLARS.length;j++){if((WEIGHTS[PILLARS[j].id]||0)!==pr[PILLARS[j].id]){ok=false;break;}}
    if(ok) return keys[i];
  }
  return null;
}
function renderWeights(){
  var grid=document.getElementById("wgrid"); if(!grid) return;
  var order=["GOV","DAT","TEC","OPE","SOC","IA"], html="";
  order.forEach(function(id){
    var p=PILLARS.filter(function(x){return x.id===id;})[0]; if(!p) return;
    var col=PILLAR_COLOR[id], w=WEIGHTS[id]||0;
    html+='<div class="wrow">'+
      '<div class="wlab"><span class="wswatch" style="background:'+col+'">'+pillarIcon(id)+'</span><span>'+escapeHtml(t(p.name))+'</span></div>'+
      '<input type="range" min="0" max="40" step="1" value="'+w+'" data-w="'+id+'" style="accent-color:'+col+'" aria-label="'+escapeHtml(t(p.name))+'">'+
      '<span class="wval" data-wv="'+id+'">'+w+'&nbsp;%</span></div>';
  });
  grid.innerHTML=html;
  updateWeightChrome();
}
function updateWeightChrome(){
  var tot=weightTotal();
  var tt=document.getElementById("wtotal"); if(tt) tt.textContent=ui("total")+" : "+tot+" %";
  var nt=document.getElementById("wnote"); if(nt) nt.textContent=(tot!==100)?("· "+ui("renorm")):"";
  var ap=activePreset();
  document.querySelectorAll("#wpresets .wp").forEach(function(b){b.classList.toggle("on",b.getAttribute("data-preset")===ap);});
  var pl=document.getElementById("wpersoLbl"); if(pl) pl.style.display=ap?"none":"inline";
}
function applyPreset(key){
  var pr=WEIGHT_PRESETS[key]; if(!pr) return;
  PILLARS.forEach(function(p){if(typeof pr[p.id]==="number")WEIGHTS[p.id]=pr[p.id];});
  saveWeights(); renderWeights(); updateResults();
}

function globalMean(){
  var wsum=0, acc=0;
  PILLARS.forEach(function(p){
    var m=pillarMean(p);
    if(m!==null){var w=WEIGHTS[p.id]||0; acc+=m*w; wsum+=w;}
  });
  return wsum>0 ? acc/wsum : null;
}
function answeredCount(){
  var n=0;
  PILLARS.forEach(function(p){p.controls.forEach(function(c){
    c.questions.forEach(function(_,qi){if(answers[c.id+"__"+qi]!==undefined)n++;});
  });});
  return n;
}

/* ---------------- Mise à jour visuelle ---------------- */
function updateBox(cId){
  var el=document.querySelector('[data-ctrl="'+cId+'"]');
  if(!el)return;
  var meta=CONTROL_INDEX[cId], m=controlMean(cId);
  var badge=el.querySelector(".badge");
  el.classList.toggle("has-notes",controlHasNotes(cId));
  el.classList.remove("scored","l2");
  if(!m){
    el.style.background="#fff";
    el.style.borderColor=meta.color;
    el.style.color="";
    return;
  }
  var lvl=Math.round(m.mean);
  el.classList.add("scored"); if(lvl===2)el.classList.add("l2");
  el.style.background=CMMI[lvl];
  el.style.borderColor=CMMI[lvl];
  el.style.color=txtColorFor(lvl);
  badge.textContent=lvl;
}
function updateAllBoxes(){PILLARS.forEach(function(p){p.controls.forEach(function(c){updateBox(c.id);});});}

function updateResults(){
  /* progress */
  var done=answeredCount();
  document.getElementById("progFill").style.width=(done/TOTAL_Q*100)+"%";
  document.getElementById("progTxt").textContent=done+" / "+TOTAL_Q+" "+ui("questionsProcessed");
  /* global */
  var g=globalMean();
  var gn=document.getElementById("gNum"), gl=document.getElementById("gLab");
  if(g===null){gn.innerHTML="—<span> / 4</span>";gn.style.color="var(--ink2)";gl.textContent=ui("overallScore");}
  else{
    var lvl=Math.round(g);
    gn.innerHTML=g.toFixed(2)+"<span> / 4</span>";
    gn.style.color=CMMI[lvl];
    gl.textContent=ui("level")+" "+lvl+" — "+cmmiName(lvl);
  }
  renderPillarBars();
  renderRadar();
  if(recoShown) renderRecos();
}

function renderPillarBars(){
  var box=document.getElementById("pillarBars"), html="";
  PILLARS.forEach(function(p){
    var m=pillarMean(p);
    var pct=m===null?0:(m/4*100);
    var lvl=m===null?null:Math.round(m);
    var col=m===null?"#dcdce1":CMMI[lvl];
    var tag=m===null?'<span class="empty">'+ui("notAssessed")+'</span>'
        :'<span class="lvtag'+(lvl===2?' l2':'')+'" style="background:'+CMMI[lvl]+'">'+m.toFixed(2)+' · '+cmmiName(lvl)+'</span>';
    html+='<div class="pbar"><div class="top"><b>'+escapeHtml(t(p.name))+'</b><span class="wpct">'+(WEIGHTS[p.id]||0)+'%</span>'+tag+'</div>'+
          '<div class="track"><i style="width:'+pct+'%;background:'+col+'"></i></div></div>';
  });
  box.innerHTML=html;
}

function renderRadar(){
  var labels=RADAR_LABELS[LANG]||RADAR_LABELS.fr;
  var vals=PILLARS.map(function(p){var m=pillarMean(p);return m===null?0:m;});
  var hasAny=PILLARS.some(function(p){return pillarMean(p)!==null;});
  var W=380,H=360,cx=190,cy=168,R=112,n=6;
  function ang(i){return (-90+i*60)*Math.PI/180;}
  function pt(i,r){return [cx+r*Math.cos(ang(i)),cy+r*Math.sin(ang(i))];}
  var svg='<svg viewBox="0 0 '+W+' '+H+'" width="'+W+'" role="img" aria-label="Radar de maturité par pilier">';
  for(var lv=1;lv<=4;lv++){
    var r=R*lv/4,pts="";
    for(var i=0;i<n;i++){var q=pt(i,r);pts+=q[0].toFixed(1)+","+q[1].toFixed(1)+" ";}
    svg+='<polygon points="'+pts+'" fill="none" stroke="#e8e8ee" stroke-width="1"/>';
  }
  for(var i2=0;i2<n;i2++){var e=pt(i2,R);svg+='<line x1="'+cx+'" y1="'+cy+'" x2="'+e[0].toFixed(1)+'" y2="'+e[1].toFixed(1)+'" stroke="#e8e8ee" stroke-width="1"/>';}
  if(hasAny){
    var dp="";for(var i3=0;i3<n;i3++){var d=pt(i3,R*vals[i3]/4);dp+=d[0].toFixed(1)+","+d[1].toFixed(1)+" ";}
    svg+='<polygon points="'+dp+'" fill="rgba(124,39,128,.22)" stroke="#7C2780" stroke-width="2"/>';
    for(var i4=0;i4<n;i4++){var c=pt(i4,R*vals[i4]/4);svg+='<circle cx="'+c[0].toFixed(1)+'" cy="'+c[1].toFixed(1)+'" r="3.5" fill="#7C2780"/>';}
  }
  for(var i5=0;i5<n;i5++){
    var l=pt(i5,R+24),x=l[0],y=l[1];
    var anchor=Math.abs(x-cx)<6?"middle":(x<cx?"end":"start");
    svg+='<text x="'+x.toFixed(0)+'" y="'+(y+4).toFixed(0)+'" text-anchor="'+anchor+'" font-size="11.5" font-weight="600" fill="#4a4f60">'+labels[i5]+'</text>';
  }
  svg+='</svg>';
  document.getElementById("radarBox").innerHTML = hasAny ? svg : svg+'<div class="empty" style="margin-top:8px">'+ui("radarEmpty")+'</div>';
}

/* ---------------- Panneau de questions ---------------- */
var activeCtrl=null;
function openControl(cId){
  var meta=CONTROL_INDEX[cId], c=meta.ctrl;
  activeCtrl=cId;
  document.querySelectorAll(".ctrl").forEach(function(e){e.classList.toggle("active",e.getAttribute("data-ctrl")===cId);});
  var panel=document.getElementById("panel");
  document.getElementById("panelHead").style.background=meta.color;
  document.getElementById("panelMeta").textContent=t(meta.pillar.name);
  document.getElementById("panelTitle").textContent=t(c.name)+(c.sub?" — "+t(c.sub):"");
  var body="";
  c.questions.forEach(function(qq,qi){
    var name=cId+"__"+qi, cur=answers[name];
    body+='<div class="q"><p class="qt"><b>Q'+(qi+1)+'.</b> '+escapeHtml(t(qq.q))+'</p><div class="opts">';
    qq.a.forEach(function(opt,lv){
      var sel=cur===String(lv)?" sel":"";
      var l2=lv===2?" l2":"";
      body+='<label class="opt'+sel+'" style="--oc:'+CMMI[lv]+'" title="'+ui("level")+' '+lv+' — '+escapeHtml(cmmiName(lv))+'"><input type="radio" name="'+name+'" value="'+lv+'"'+(cur===String(lv)?" checked":"")+'>'+
            '<span class="lv'+l2+'" style="background:'+CMMI[lv]+'">'+lv+'</span>'+
            '<span class="ot">'+escapeHtml(t(opt))+'</span></label>';
    });
    var selna=cur==="na"?" sel":"";
    body+='<label class="opt na'+selna+'" title="'+ui("naTitle")+'"><input type="radio" name="'+name+'" value="na"'+(cur==="na"?" checked":"")+'>'+
          '<span class="lv">N/A</span><span class="ot">'+ui("na")+'</span></label>';
    body+='</div>';
    var nval=notes[name]?escapeHtml(notes[name]):"";
    body+='<div class="ev"><label class="evlbl" for="ev_'+name+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 3.5a2.12 2.12 0 0 1 3 3L8 17l-4 1 1-4Z"/></svg>'+ui("evidence")+'</label>'+
          '<textarea class="evta" id="ev_'+name+'" data-note="'+name+'" rows="2" placeholder="'+escapeHtml(ui("evPlaceholder"))+'">'+nval+'</textarea></div>';
    body+='</div>';
  });
  document.getElementById("panelBody").innerHTML=body;
  panel.classList.add("open");
  panel.scrollIntoView({behavior:"smooth",block:"start"});
}
function closePanel(){
  document.getElementById("panel").classList.remove("open");
  document.querySelectorAll(".ctrl.active").forEach(function(e){e.classList.remove("active");});
  activeCtrl=null;
}

/* ---------------- Évènements ---------------- */
function escapeHtml(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}

document.getElementById("frame").addEventListener("click",function(e){
  var box=e.target.closest(".ctrl"); if(box) openControl(box.getAttribute("data-ctrl"));
});
document.getElementById("frame").addEventListener("keydown",function(e){
  var box=e.target.closest(".ctrl");
  if(box&&(e.key==="Enter"||e.key===" ")){e.preventDefault();openControl(box.getAttribute("data-ctrl"));}
});
document.getElementById("panelClose").addEventListener("click",closePanel);
document.getElementById("panelBody").addEventListener("change",function(e){
  if(e.target&&e.target.type==="radio"){
    var name=e.target.name, cId=name.split("__")[0];
    answers[name]=e.target.value;
    save();
    /* maj visuelle des labels sélectionnés dans le panneau */
    var group=document.getElementsByName(name);
    Array.prototype.forEach.call(group,function(r){r.closest(".opt").classList.toggle("sel",r.checked);});
    updateBox(cId);
    updateResults();
  }
});
document.getElementById("panelBody").addEventListener("input",function(e){
  if(e.target&&e.target.classList&&e.target.classList.contains("evta")){
    var key=e.target.getAttribute("data-note");
    var val=e.target.value;
    if(val.trim()===""){delete notes[key];} else {notes[key]=val;}
    saveNotes();
    updateBox(key.split("__")[0]);
  }
});
document.getElementById("resetBtn").addEventListener("click",function(){
  if(!confirm(ui("confirmReset")))return;
  answers={};save();
  notes={};saveNotes();
  recoShown=false;
  var ro=document.getElementById("recoOut");ro.classList.remove("open");ro.innerHTML="";
  updateAllBoxes();updateResults();
  if(activeCtrl)openControl(activeCtrl);
});

/* ---------------- Recommandations ---------------- */
var recoShown=false;
function priorityOf(level){return level<=1?1:(level===2?2:3);}
function prioLabel(pr){return t(pr===1?"À traiter en priorité":pr===2?"À planifier":"À intégrer à moyen terme");}
function prioColor(pr){return pr===1?CMMI[0]:pr===2?CMMI[1]:CMMI[4];}

function buildRecos(){
  var list=[];
  PILLARS.forEach(function(p){p.controls.forEach(function(c){
    var m=controlMean(c.id); if(!m) return;
    var level=Math.round(m.mean); if(level>=4) return;
    var r=RECO[c.id]; if(!r) return;
    list.push({pillar:p,ctrl:c,level:level,prio:priorityOf(level),act:r.act,cost:r.cost,cx:r.cx,months:r.m});
  });});
  list.sort(function(a,b){return a.prio-b.prio || a.months-b.months || a.cost-b.cost;});
  return list;
}

function dotsHTML(n,cls){var s='<span class="dots '+(cls||"")+'">';for(var i=1;i<=3;i++){s+='<i class="'+(i<=n?"on":"")+'"></i>';}return s+'</span>';}
function statHTML(cls,n,k){return '<div class="stat '+cls+'"><div class="n">'+n+'</div><div class="k">'+k+'</div></div>';}

function recoCard(r){
  var prc=prioColor(r.prio);
  var sub=r.ctrl.sub?' <span style="font-weight:400;color:var(--ink2)">('+escapeHtml(t(r.ctrl.sub))+')</span>':'';
  return '<div class="rcard" style="border-left-color:'+prc+'">'+
    '<div><span class="ptag" style="background:'+prc+'">P'+r.prio+'</span>'+
    '<p class="cname">'+escapeHtml(t(r.ctrl.name))+sub+'</p>'+
    '<p class="act">'+escapeHtml(t(r.act))+'</p>'+
    '<div class="curlv">'+escapeHtml(t(r.pillar.name))+' · '+ui("currentLevel")+' <b>'+r.level+' — '+cmmiName(r.level)+'</b> &rarr; '+ui("target")+' <b>4</b></div></div>'+
    '<div class="rmeta">'+
      '<div class="mi"><span class="lab">'+ui("cost")+'</span>'+dotsHTML(r.cost,"cost")+'<span>'+t(COST_LABEL[r.cost])+'</span></div>'+
      '<div class="mi"><span class="lab">'+ui("complexity")+'</span>'+dotsHTML(r.cx)+'<span>'+t(CX_LABEL[r.cx])+'</span></div>'+
      '<div class="mi"><span class="lab">'+ui("duration")+'</span><span class="months">'+r.months+' '+ui("months")+'</span></div>'+
    '</div></div>';
}

function waveStart(pr){return pr===1?0:pr===2?6:12;}

function timelineHTML(recos){
  var maxM=12;
  recos.forEach(function(r){maxM=Math.max(maxM,waveStart(r.prio)+r.months);});
  maxM=Math.ceil(maxM/3)*3;
  var html='<div class="rgroup"><h3>'+ui("roadmap")+'</h3>';
  html+='<div class="gantt" style="--lblw:230px;--mw:calc(100% / '+(maxM/3)+')">';
  html+='<div class="axis">';
  for(var t2=0;t2<=maxM;t2+=3){html+='<div class="tk" style="left:'+(t2/maxM*100)+'%">M'+t2+'</div>';}
  html+='</div>';
  [1,2,3].forEach(function(pr){
    var items=recos.filter(function(r){return r.prio===pr;});
    if(!items.length) return;
    var ws=waveStart(pr),prc=prioColor(pr);
    html+='<div class="gwave"><div class="wh">'+ui("wave")+' '+pr+' · P'+pr+' — '+ui("startsAt")+' M'+ws+'</div>';
    items.forEach(function(r){
      var leftPct=ws/maxM*100,wPct=r.months/maxM*100;
      html+='<div class="grow"><div class="gl" title="'+escapeHtml(t(r.ctrl.name))+'">'+escapeHtml(t(r.ctrl.name))+'</div>'+
        '<div class="gtrack"><div class="gbar" style="left:'+leftPct+'%;width:'+wPct+'%;background:'+prc+'">'+r.months+'m</div></div></div>';
    });
    html+='</div>';
  });
  html+='<div class="gnote">'+ui("ganttNote")+'</div>';
  html+='</div></div>';
  return html;
}

function renderRecos(){
  var out=document.getElementById("recoOut");
  out.classList.add("open");
  if(answeredCount()===0){out.innerHTML='<h2>'+ui("recommendations")+'</h2><p class="empty">'+ui("recoNoAnswer")+'</p>';return;}
  var recos=buildRecos();
  if(recos.length===0){out.innerHTML='<h2>'+ui("recommendations")+'</h2><p class="rsub">'+ui("recoAllSovereign")+'</p>';return;}
  var nP=[0,0,0,0];recos.forEach(function(r){nP[r.prio]++;});
  var qw=recos.filter(function(r){return r.cost<=1&&r.cx<=1;}).length;
  var totM=recos.reduce(function(s,r){return s+r.months;},0);
  var rsub = LANG==="en"
    ? recos.length+' recommendation(s) derived from controls assessed below the sovereign level. Priority reflects the maturity gap; the indicative cumulative effort is '+totM+' month·action.'
    : recos.length+' recommandation(s) issues des contrôles évalués sous le niveau souverain. La priorité reflète l\'écart de maturité ; l\'effort cumulé indicatif est de '+totM+' mois·action.';
  var html='<h2>'+ui("recoTitle")+'</h2>';
  html+='<p class="rsub">'+rsub+'</p>';
  html+='<div class="synth">'+statHTML("p1",nP[1],ui("prio")+" P1")+statHTML("p2",nP[2],ui("prio")+" P2")+statHTML("p3",nP[3],ui("prio")+" P3")+statHTML("qw",qw,ui("quickWins"))+'</div>';
  [1,2,3].forEach(function(pr){
    var items=recos.filter(function(r){return r.prio===pr;});
    if(!items.length) return;
    html+='<div class="rgroup"><h3><span class="pbadge p'+pr+'">P'+pr+'</span> '+prioLabel(pr)+' — '+items.length+' '+ui("actions")+'</h3>';
    items.forEach(function(r){html+=recoCard(r);});
    html+='</div>';
  });
  html+=timelineHTML(recos);
  out.innerHTML=html;
}

document.getElementById("genReco").addEventListener("click",function(){
  recoShown=true;
  renderRecos();
  document.getElementById("recoOut").scrollIntoView({behavior:"smooth",block:"start"});
});

