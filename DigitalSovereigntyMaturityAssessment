/* ---------------- Calculs ---------------- */
function controlMean(cId){
  var c=CONTROL_INDEX[cId].ctrl, sum=0, n=0;
  c.questions.forEach(function(_,qi){
    var v=answers[cId+"__"+qi];
    if(v!==undefined && v!=="na"){sum+=parseInt(v,10);n++;}
  });
  return n? {mean:sum/n,count:n} : null;
}
function pillarMean(p){
  var sum=0,n=0;
  p.controls.forEach(function(c){var m=controlMean(c.id); if(m){sum+=m.mean;n++;}});
  return n? sum/n : null;
}
