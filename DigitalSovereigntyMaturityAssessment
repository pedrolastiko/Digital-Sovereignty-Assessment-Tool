<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Questionnaire de souveraineté numérique</title>
<style>
  :root{
    --red:#D11A45; --magenta:#A72162; --purple:#7C2780; --violet:#512E9E;
    --grad:linear-gradient(90deg,#D11A45 0%,#A72162 34%,#7C2780 67%,#512E9E 100%);
    --c0:#E5484D; --c1:#F2843B; --c2:#E5B23C; --c3:#84B53F; --c4:#2BA672;
    --ink:#1f2330; --ink2:#5b6072; --line:#e4e4ea; --bg:#f6f6f9; --card:#ffffff;
    --radius:8px;
    --font:'IBM Plex Sans','Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:var(--font);color:var(--ink);background:var(--bg);line-height:1.5;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1200px;margin:0 auto;padding:28px 20px 64px}

  header.page{margin-bottom:24px;position:relative}
  .brand-logo{height:40px;width:auto;display:block;margin-bottom:18px}
  @media(max-width:560px){.brand-logo{height:30px;margin-bottom:14px}}
  .langtoggle{position:absolute;top:0;right:0;display:inline-flex;border:1px solid var(--line);
              border-radius:999px;overflow:hidden;background:#fff}
  .langtoggle button{border:0;background:transparent;font-family:inherit;font-size:12px;font-weight:700;
                     color:var(--ink2);padding:6px 15px;cursor:pointer;letter-spacing:.03em}
  .langtoggle button.on{background:var(--grad);color:#fff}
  .eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;
           letter-spacing:.09em;text-transform:uppercase;color:var(--purple);margin-bottom:13px}
  .eyebrow::before{content:"";width:32px;height:3px;border-radius:2px;background:var(--grad)}
  header.page h1{font-size:34px;font-weight:700;line-height:1.1;letter-spacing:-.022em;margin:0 0 10px;max-width:800px}
  header.page h1 .grad{color:var(--violet)}
  @supports((-webkit-background-clip:text) or (background-clip:text)){
    header.page h1 .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;
                         -webkit-text-fill-color:transparent;color:transparent}
  }
  header.page p.lead{margin:0;color:var(--ink2);font-size:15px;line-height:1.62;max-width:780px}
  header.page p.lead strong{color:var(--ink);font-weight:600}
  @media(max-width:560px){header.page h1{font-size:26px}}

  .legend{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 8px;align-items:center}
  .legend .lbl{font-size:12px;color:var(--ink2);margin-right:2px}
  .chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;
        padding:4px 9px;border-radius:999px;color:#fff}
  .chip b{font-weight:700}
  .chip.l2{color:#5a4410}

  .toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;
           background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
           padding:12px 16px;margin:14px 0 22px}
  .progress{flex:1;min-width:220px}
  .progress .bar{height:8px;background:#ececed;border-radius:999px;overflow:hidden}
  .progress .bar i{display:block;height:100%;width:0;background:var(--grad);transition:width .3s}
  .progress .txt{font-size:12px;color:var(--ink2);margin-top:6px}
  .gscore{display:flex;align-items:center;gap:12px}
  .gscore .num{font-size:30px;font-weight:700;line-height:1}
  .gscore .num span{font-size:15px;color:var(--ink2);font-weight:500}
  .gscore .lab{font-size:12px;color:var(--ink2);max-width:140px}
  .btn{border:1px solid var(--line);background:#fff;color:var(--ink);font-family:inherit;
       font-size:13px;font-weight:500;padding:8px 14px;border-radius:var(--radius);cursor:pointer}
  .btn:hover{border-color:#c9c9d2}

  /* ---- Framework frame ---- */
  .frame{display:flex;flex-direction:column;gap:10px;--ch:100px}
  .banner{background:var(--grad);color:#fff;border-radius:6px;text-align:center;
          padding:12px 16px;font-weight:600;font-size:17px;letter-spacing:.01em;
          display:flex;align-items:center;justify-content:center;gap:10px}
  .row{display:grid;gap:10px}
  .row.g{grid-template-columns:repeat(4,1fr)}
  .row.ia{grid-template-columns:repeat(5,1fr)}
  .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;align-items:start}
  .col{display:flex;flex-direction:column;gap:10px}
  .phead{color:#fff;border-radius:6px;text-align:center;padding:11px 10px;font-weight:600;
         font-size:14.5px;line-height:1.25;min-height:54px;display:flex;align-items:center;justify-content:center;gap:8px}
  .cicon{flex:none;stroke:#fff}
  .banner .cicon{width:22px;height:22px}
  .phead .cicon{width:18px;height:18px}

  .ctrl{position:relative;background:#fff;border:2px solid var(--red);border-radius:6px;
        padding:10px;cursor:pointer;text-align:center;transition:box-shadow .15s,transform .05s;
        height:var(--ch);overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:3px}
  .ctrl:hover{box-shadow:0 2px 10px rgba(40,30,60,.12)}
  .ctrl:active{transform:translateY(1px)}
  .ctrl .nm{font-size:13px;font-weight:500;line-height:1.22}
  .ctrl .sub{font-size:10.5px;font-style:italic;opacity:.78;line-height:1.15}
  .ctrl.scored{color:#fff;border-color:transparent}
  .ctrl.scored.l2{color:#5a4410}
  .ctrl.scored .sub{opacity:.9}
  .ctrl .badge{position:absolute;top:6px;right:7px;width:20px;height:20px;border-radius:50%;
        font-size:11px;font-weight:700;display:none;align-items:center;justify-content:center;
        background:rgba(255,255,255,.92);color:#222}
  .ctrl.scored .badge{display:flex}
  .ctrl.scored.l2 .badge{background:rgba(0,0,0,.12);color:#5a4410}
  .ctrl .evmark{position:absolute;top:7px;left:8px;width:13px;height:13px;display:none;color:var(--purple);opacity:.85}
  .ctrl .evmark svg{width:100%;height:100%;display:block}
  .ctrl.scored .evmark{color:#fff;opacity:.95}
  .ctrl.scored.l2 .evmark{color:#5a4410}
  .ctrl.has-notes .evmark{display:block}
  .ctrl.active{box-shadow:0 0 0 3px rgba(124,39,128,.35),0 4px 14px rgba(40,30,60,.16)}

  /* ---- Question panel ---- */
  .panel{margin-top:20px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
         overflow:hidden;display:none}
  .panel.open{display:block;animation:fade .2s ease}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  .panel .ph{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;
             padding:16px 18px;color:#fff}
  .panel .ph .meta{font-size:12px;opacity:.9;margin-bottom:3px;text-transform:uppercase;letter-spacing:.04em}
  .panel .ph h2{margin:0;font-size:17px;font-weight:600}
  .panel .ph .x{background:rgba(255,255,255,.18);border:0;color:#fff;width:30px;height:30px;border-radius:6px;
                cursor:pointer;font-size:18px;line-height:1;flex:none}
  .panel .ph .x:hover{background:rgba(255,255,255,.3)}
  .qbody{padding:8px 18px 20px}
  .q{padding:16px 0;border-bottom:1px solid var(--line)}
  .q:last-child{border-bottom:0}
  .q .qt{font-size:14.5px;font-weight:500;margin:0 0 11px}
  .q .qt b{color:var(--purple)}
  .opts{display:flex;flex-wrap:wrap;gap:8px;align-items:stretch}
  .opt{--oc:#9a9aa3;flex:1 1 0;min-width:130px;display:flex;flex-direction:column;align-items:center;
       text-align:center;gap:8px;border:1.5px solid var(--line);border-radius:9px;padding:11px 9px 13px;
       cursor:pointer;font-size:12.5px;line-height:1.3;transition:border-color .12s,background .12s,box-shadow .12s}
  .opt:hover{border-color:var(--oc);background:#fafafb}
  .opt:focus-within{border-color:var(--oc);box-shadow:0 0 0 2px rgba(124,39,128,.28)}
  .opt input{position:absolute;opacity:0;width:1px;height:1px}
  .opt .lv{flex:none;width:30px;height:30px;border-radius:50%;color:#fff;font-size:13px;font-weight:700;
           display:flex;align-items:center;justify-content:center}
  .opt .lv.l2{color:#5a4410}
  .opt.na{--oc:#9a9aa3}
  .opt.na .lv{background:#cfd0d6;color:#444;font-size:12px}
  .opt .ot{color:var(--ink2)}
  .opt.sel{border-color:var(--oc);background:color-mix(in srgb,var(--oc) 13%,#fff);box-shadow:0 0 0 1px var(--oc) inset}
  .opt.sel .ot{color:var(--ink)}
  @media(max-width:560px){.opt{min-width:88px;font-size:12px}}
  .ev{margin-top:12px}
  .evlbl{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--ink2);
         letter-spacing:.04em;text-transform:uppercase;margin-bottom:6px}
  .evlbl svg{width:13px;height:13px;flex:none;color:var(--purple)}
  .evta{width:100%;box-sizing:border-box;font-family:inherit;font-size:13px;line-height:1.45;color:var(--ink);
        border:1px solid var(--line);border-radius:8px;padding:9px 11px;resize:vertical;min-height:46px;background:#fff;
        transition:border-color .12s,box-shadow .12s}
  .evta::placeholder{color:#9a9aa3}
  .evta:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px rgba(124,39,128,.12)}

  /* ---- Results ---- */
  .results{margin-top:30px}
  .results h2{font-size:18px;font-weight:600;margin:0 0 14px}
  .rgrid{display:grid;grid-template-columns:1.1fr .9fr;gap:22px;align-items:start}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px}
  .card h3{margin:0 0 14px;font-size:14px;font-weight:600;color:var(--ink2);text-transform:uppercase;letter-spacing:.03em}
  .pbar{margin-bottom:13px}
  .pbar .top{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px}
  .pbar .top b{font-weight:600}
  .pbar .top .wpct{margin-left:7px;margin-right:auto;font-size:11px;font-weight:600;color:var(--ink2);
        background:#f0f0f3;border-radius:999px;padding:1px 7px}
  .pbar .track{height:9px;background:#ececed;border-radius:999px;overflow:hidden}
  .pbar .track i{display:block;height:100%;width:0;border-radius:999px;transition:width .35s,background .2s}
  .pbar .lvtag{font-size:11px;font-weight:600;color:#fff;padding:1px 7px;border-radius:999px}
  .pbar .lvtag.l2{color:#5a4410}
  .radar{display:flex;flex-direction:column;align-items:center}
  .radar svg{max-width:100%;height:auto}
  .empty{color:var(--ink2);font-size:13px;font-style:italic}

  /* ---- Pondération ---- */
  .wcard{margin-bottom:22px}
  .whead{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
  .whead h3{margin:0}
  .whint{font-size:12.5px;color:var(--ink2);margin:9px 0 16px;line-height:1.45}
  .wpresets{display:flex;flex-wrap:wrap;gap:6px}
  .wp{border:1px solid var(--line);background:#fff;font-family:inherit;font-size:12px;font-weight:600;
      color:var(--ink2);padding:5px 12px;border-radius:999px;cursor:pointer;transition:border-color .12s,color .12s,background .12s}
  .wp:hover{border-color:var(--purple);color:var(--ink)}
  .wp.on{background:var(--grad);color:#fff;border-color:transparent}
  .wgrid{display:grid;grid-template-columns:1fr 1fr;gap:15px 30px}
  .wrow{display:flex;align-items:center;gap:13px}
  .wlab{display:flex;align-items:center;gap:9px;width:168px;flex:none;font-size:13px;font-weight:500;line-height:1.2}
  .wswatch{width:27px;height:27px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex:none}
  .wswatch svg{width:15px;height:15px;stroke:#fff}
  .wrow input[type=range]{flex:1;min-width:70px;height:6px;cursor:pointer}
  .wval{width:46px;text-align:right;font-variant-numeric:tabular-nums;font-weight:700;font-size:13px;color:var(--ink);flex:none}
  .wfoot{display:flex;align-items:center;gap:10px;margin-top:17px;padding-top:14px;border-top:1px solid var(--line);font-size:12.5px}
  #wtotal{font-weight:700}
  .wnote{color:var(--c1);font-weight:600}
  .wperso{margin-left:auto;font-weight:600;color:var(--purple);background:rgba(124,39,128,.09);
          border-radius:999px;padding:2px 10px;display:none}
  @media(max-width:640px){.wgrid{grid-template-columns:1fr}.wlab{width:150px}}

  /* ---- Recommandations ---- */
  .reco-cta{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:30px;
            background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px}
  .btn-primary{border:0;background:var(--grad);color:#fff;font-family:inherit;font-size:14px;font-weight:600;
               padding:11px 20px;border-radius:var(--radius);cursor:pointer;box-shadow:0 3px 12px rgba(124,39,128,.25)}
  .btn-primary:hover{filter:brightness(1.06)}
  .btn-primary:disabled{opacity:.5;cursor:not-allowed;box-shadow:none}
  .reco-hint{font-size:13px;color:var(--ink2);flex:1;min-width:200px}
  .reco{margin-top:22px;display:none}
  .reco.open{display:block}
  .reco h2{font-size:18px;font-weight:600;margin:0 0 4px}
  .reco .rsub{font-size:13px;color:var(--ink2);margin:0 0 16px}

  .synth{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px}
  .stat{flex:1;min-width:120px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
        padding:12px 14px}
  .stat .n{font-size:24px;font-weight:700;line-height:1}
  .stat .k{font-size:11.5px;color:var(--ink2);text-transform:uppercase;letter-spacing:.04em;margin-top:4px}
  .stat.p1{border-left:4px solid var(--c0)} .stat.p2{border-left:4px solid var(--c1)} .stat.p3{border-left:4px solid var(--c4)}
  .stat.qw{border-left:4px solid var(--purple)}

  .rgroup{margin-bottom:22px}
  .rgroup>h3{font-size:13px;font-weight:700;letter-spacing:.03em;margin:0 0 12px;display:flex;align-items:center;gap:9px}
  .pbadge{font-size:11px;font-weight:800;color:#fff;padding:3px 9px;border-radius:6px;letter-spacing:.02em}
  .pbadge.p1{background:var(--c0)} .pbadge.p2{background:var(--c1)} .pbadge.p3{background:var(--c4)}

  .rcard{background:var(--card);border:1px solid var(--line);border-left-width:4px;border-radius:var(--radius);
         padding:14px 16px;margin-bottom:10px;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:start}
  .rcard .ptag{font-size:11px;font-weight:600;color:#fff;padding:2px 8px;border-radius:999px;display:inline-block;margin-bottom:7px}
  .rcard .cname{font-size:14.5px;font-weight:600;margin:0 0 5px}
  .rcard .act{font-size:13.5px;color:var(--ink2);margin:0;line-height:1.5}
  .rcard .curlv{font-size:11.5px;color:var(--ink2);margin-top:7px}
  .rcard .curlv b{color:var(--ink)}
  .rmeta{display:flex;flex-direction:column;gap:9px;min-width:150px;text-align:right}
  .rmeta .mi{display:flex;align-items:center;justify-content:flex-end;gap:7px;font-size:12px;color:var(--ink2)}
  .rmeta .mi .lab{min-width:52px;text-align:right}
  .dots{display:inline-flex;gap:3px}
  .dots i{width:9px;height:9px;border-radius:50%;background:#dfe0e6;display:inline-block}
  .dots i.on{background:var(--purple)}
  .dots.cost i.on{background:var(--c1)}
  .months{font-weight:700;color:var(--ink);font-size:13px}

  /* ---- Timeline / Gantt ---- */
  .gantt{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px 8px;overflow-x:auto}
  .gantt .axis{position:relative;height:20px;margin-left:var(--lblw);border-bottom:1px solid var(--line)}
  .gantt .axis .tk{position:absolute;top:0;font-size:10.5px;color:var(--ink2);transform:translateX(-50%)}
  .gantt .axis .tk::after{content:"";position:absolute;top:15px;left:50%;width:1px;height:6px;background:var(--line)}
  .gwave{margin-top:6px}
  .gwave .wh{font-size:12px;font-weight:700;color:var(--ink2);margin:12px 0 6px;letter-spacing:.02em}
  .grow{display:grid;grid-template-columns:var(--lblw) 1fr;align-items:center;gap:0;height:30px}
  .grow .gl{font-size:12px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:12px}
  .gtrack{position:relative;height:100%;background-image:repeating-linear-gradient(90deg,transparent,transparent calc(var(--mw) - 1px),#f0f0f4 calc(var(--mw) - 1px),#f0f0f4 var(--mw))}
  .gbar{position:absolute;top:6px;height:18px;border-radius:5px;display:flex;align-items:center;justify-content:center;
        font-size:10.5px;font-weight:700;color:#fff;min-width:22px;box-shadow:inset 0 -1px 0 rgba(0,0,0,.12)}
  .gnote{font-size:11.5px;color:var(--ink2);font-style:italic;margin:10px 0 4px}

  @media(max-width:980px){
    .rgrid{grid-template-columns:1fr}
  }
  @media(max-width:900px){
    .row.g{grid-template-columns:repeat(2,1fr)}
    .row.ia{grid-template-columns:repeat(3,1fr)}
    .cols{grid-template-columns:repeat(2,1fr)}
    .frame{--ch:110px}
  }
  @media(max-width:640px){
    .rcard{grid-template-columns:1fr}
    .rmeta{text-align:left;min-width:0}
    .rmeta .mi{justify-content:flex-start}
  }
  @media(max-width:560px){
    .row.g,.row.ia{grid-template-columns:repeat(2,1fr)}
    .cols{grid-template-columns:1fr}
    .frame{--ch:116px}
  }
  @media(max-width:430px){
    .row.g,.row.ia,.cols{grid-template-columns:1fr}
    .frame{--ch:86px}
  }
</style>
</head>
<body>
<div class="wrap">
  <header class="page">
    <div class="langtoggle"><button id="langFR">FR</button><button id="langEN" class="on">EN</button></div>
    <img id="brandLogo" class="brand-logo" alt="CGI" src="data:image/png;base64,">
    <h1 id="title">Quelle est la maturité de votre <span class="grad">souveraineté numérique</span>&nbsp;?</h1>
    <div class="eyebrow" id="eyebrow">Auto-évaluation de maturité</div>
    <p class="lead" id="lead"><strong>6 piliers, 31 contrôles, 93 questions</strong> pour objectiver ce qui relève trop souvent du ressenti. Cliquez sur un élément du framework et positionnez-vous sur l'échelle CMMI&nbsp;: chaque case se colore selon sa maturité et votre profil de souveraineté se dessine en temps réel — angles morts, dépendances fournisseurs et leviers prioritaires en clair.</p>
  </header>

  <div class="toolbar">
    <div class="progress">
      <div class="bar"><i id="progFill"></i></div>
      <div class="txt"><span id="progTxt">0 / 93 question(s) traitée(s)</span></div>
    </div>
    <div class="gscore">
      <div class="num" id="gNum" style="color:var(--ink2)">—<span> / 4</span></div>
      <div class="lab" id="gLab">Score global de maturité</div>
    </div>
    <button class="btn" id="resetBtn">Réinitialiser</button>
  </div>

  <div class="frame" id="frame"></div>

  <div class="panel" id="panel">
    <div class="ph" id="panelHead">
      <div>
        <div class="meta" id="panelMeta"></div>
        <h2 id="panelTitle"></h2>
      </div>
      <button class="x" id="panelClose" aria-label="Fermer">&times;</button>
    </div>
    <div class="qbody" id="panelBody"></div>
  </div>

  <div class="results">
    <h2 id="resultsTitle">Restitution</h2>
    <div class="card wcard">
      <div class="whead">
        <h3 id="weightTitle">Pondération des piliers</h3>
        <div class="wpresets" id="wpresets">
          <button type="button" class="wp" data-preset="balanced">Équilibré</button>
          <button type="button" class="wp" data-preset="infra">Infra critique</button>
          <button type="button" class="wp" data-preset="data">Données régulées</button>
          <button type="button" class="wp" data-preset="ai">IA-first</button>
          <button type="button" class="wp" data-preset="csf">CSF strict</button>
        </div>
      </div>
      <p class="whint" id="weightHint">La note globale est pondérée selon l'importance de chaque pilier. Ajustez les curseurs ou choisissez un profil.</p>
      <div class="wgrid" id="wgrid"></div>
      <div class="wfoot"><span id="wtotal">Total : 100 %</span><span class="wnote" id="wnote"></span><span class="wperso" id="wpersoLbl">Personnalisé</span></div>
    </div>
    <div class="rgrid">
      <div class="card">
        <h3 id="pillarCardTitle">Maturité par pilier</h3>
        <div id="pillarBars"></div>
      </div>
      <div class="card radar">
        <h3 id="radarCardTitle">Profil de souveraineté</h3>
        <div id="radarBox"></div>
      </div>
    </div>
  </div>

  <div class="reco-cta">
    <button class="btn-primary" id="genReco">Générer les recommandations</button>
