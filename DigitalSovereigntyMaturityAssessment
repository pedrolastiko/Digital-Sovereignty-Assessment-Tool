function rerenderAll(){
  applyI18n();
  renderFrame();
  updateAllBoxes();
  renderWeights();
  updateResults();
  if(activeCtrl) openControl(activeCtrl);
}
function setLang(l){
  if(l!=="fr"&&l!=="en")return;
  LANG=l;
  try{localStorage.setItem("qsov_lang",l);}catch(e){}
  rerenderAll();
}
document.getElementById("langFR").addEventListener("click",function(){setLang("fr");});
document.getElementById("langEN").addEventListener("click",function(){setLang("en");});

/* Pondération : presets + curseurs */
document.getElementById("wpresets").addEventListener("click",function(e){
  var b=e.target.closest(".wp"); if(b) applyPreset(b.getAttribute("data-preset"));
});
